[Unit]
Description=Option Wheel Trading Engine
Wants=network-online.target futu-api.service
After=network-online.target futu-api.service

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStartPre=/bin/bash -c "for i in {1..60}; do nc -z @FUTU_OPEND_ADDRESS@ @FUTU_OPEND_PORT@ && exit 0; sleep 1; done; exit 1"
ExecStart="@APP_DIR@/.venv/bin/python" -m trading.main
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=multi-user.target
